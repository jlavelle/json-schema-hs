#!/usr/bin/env python3
"""Writes internal/Text/Regex/Ecma262/Internal/Ucd/Tables.hs from ucd/tables.ml of Corvus.JsonSchema's OCaml port.

Usage: scripts/gen-ucd-tables <Corvus.JsonSchema checkout>

The tables are taken from Corvus's OCaml tables rather than from the Unicode Character Database, so that they match
the engine this package ports. The generated header records the Corvus commit and the Unicode version.
"""

import pathlib
import re
import struct
import subprocess
import sys

HEADER = """{- Code generated by scripts/gen-ucd-tables from src-ml/corvus-json-schema/ucd/tables.ml of
   Corvus.JsonSchema (https://github.com/corvus-dotnet/Corvus.JsonSchema) at commit %s,
   Unicode %s. DO NOT EDIT. -}
{-# LANGUAGE MagicHash #-}

module Text.Regex.Ecma262.Internal.Ucd.Tables
  ( caseFolds
  , upperCases
  , categoryTables
  , binaryTables
  , scriptTables
  , scriptExtensionsTables
  ) where

import Data.Text qualified as Text

import Text.Regex.Ecma262.Internal.Ucd.Table qualified as Table
"""


def ocaml_string_bytes(literal):
    body = re.sub(r"\\\n\s*", "", literal)
    out = bytearray()
    k = 0
    while k < len(body):
        c = body[k]
        if c == "\\":
            if body[k + 1] == "x":
                out.append(int(body[k + 2 : k + 4], 16))
                k += 4
                continue
            raise ValueError("unexpected escape %r" % body[k : k + 4])
        out.append(ord(c))
        k += 1
    return bytes(out)


def addr_literal(data):
    return '"' + "".join("\\x%02x" % b for b in data) + '"#'


def camel(name):
    parts = name.split("_")
    return parts[0] + "".join(p[:1].upper() + p[1:] for p in parts[1:])


def main(checkout):
    source = (pathlib.Path(checkout) / "src-ml/corvus-json-schema/ucd/tables.ml").read_text()
    commit = subprocess.run(
        ["git", "-C", checkout, "rev-parse", "HEAD"], check=True, capture_output=True, text=True
    ).stdout.strip()
    version = re.search(r'let version = "([^"]+)"', source).group(1)
    out = [HEADER % (commit, version)]

    tables = re.finditer(
        r'^let ((?:gc|bin|sc|scx)_[a-z0-9_]+) =\s*\{\s*r16 =\s*"((?:[^"\\]|\\.|\\\n)*)";\s*r32 =\s*"((?:[^"\\]|\\.|\\\n)*)"\s*\}',
        source,
        re.M,
    )
    count = 0
    for m in tables:
        name, r16, r32 = m.group(1), ocaml_string_bytes(m.group(2)), ocaml_string_bytes(m.group(3))
        out.append(
            "\n%s :: Table.Table\n%s = Table.Table %s %d %s %d\n"
            % (camel(name), camel(name), addr_literal(r16), len(r16), addr_literal(r32), len(r32))
        )
        count += 1

    for name in ("case_folds", "upper_cases"):
        body = re.search(r"^let %s =\s*\[\|(.*?)\|\]" % name, source, re.M | re.S).group(1)
        values = [int(v.strip().strip("()"), 0) for v in body.split(";") if v.strip()]
        data = b"".join(struct.pack("<i", v) for v in values)
        out.append(
            "\n%s :: Table.CaseTable\n%s = Table.CaseTable %s %d\n"
            % (camel(name), camel(name), addr_literal(data), len(values) // 4)
        )

    for name in ("category_table", "binary_table", "script_table", "script_extensions_table"):
        body = re.search(r"^let %s = function\n(.*?)\n  \| _ -> None" % name, source, re.M | re.S).group(1)
        entries = []
        for line in body.splitlines():
            alt = re.match(r"\s*\| (.*) -> Some ([a-z0-9_]+)$", line)
            for key in re.findall(r'"([^"]+)"', alt.group(1)):
                entries.append('("%s", %s)' % (key, camel(alt.group(2))))
        hs = camel(name.replace("_table", "_tables"))
        out.append(
            "\n%s :: [(Text.Text, Table.Table)]\n%s =\n  [ %s\n  ]\n" % (hs, hs, "\n  , ".join(entries))
        )

    target = pathlib.Path(__file__).resolve().parent.parent / "internal/Text/Regex/Ecma262/Internal/Ucd/Tables.hs"
    target.write_text("".join(out))
    print("wrote %d tables to %s" % (count, target))


if __name__ == "__main__":
    main(sys.argv[1])
