cabal-version: 3.0
name: json-schema-hs-fleece
version: 0.1.0.0
synopsis: json-fleece support for json-schema-hs
description:
  A Fleece codec for JSON Schema Draft 2020-12 documents, a Fleece decoder
  that keeps the key order of keyword maps, and a Fleece interpreter that
  generates a JSON Schema from a Fleece description.

category: Data, Web, JSON
license: MIT
license-file: LICENSE
author: Nebula Lavelle
maintainer: nebula@franticdream.xyz
copyright: 2026 Nebula Lavelle
build-type: Simple
tested-with: ghc ==9.10.3

flag ci
  description: More strict ghc options used for development and ci, not intended for end-use.
  manual: True
  default: False

common foundation
  build-depends: base >=4.20 && <5

  if flag(ci)
    build-depends: henforcer
    ghc-options:
      -j
      -fwrite-ide-info
      -hiedir=.hie
      -Weverything
      -Werror
      -Wno-missing-import-lists
      -Wno-missing-local-signatures
      -Wno-monomorphism-restriction
      -Wno-missing-kind-signatures
      -Wprepositive-qualified-module
      -Wno-safe
      -Wno-unsafe
      -Wno-missing-safe-haskell-mode
      -Wno-missing-deriving-strategies
      -Wno-all-missed-specialisations
      -Wno-missed-specialisations
      -Wno-implicit-prelude
      -Wno-missing-role-annotations
      -Wno-unused-packages
      -fplugin
      Henforcer
      -fplugin-opt
      Henforcer:-c../henforcer.toml
  default-extensions:
    OverloadedStrings

  default-language: GHC2024

library
  import: foundation
  exposed-modules:
    JsonSchema.Fleece
    JsonSchema.Generate
    JsonSchema.OrderedDecoder
    JsonSchema.OrderedProperties

  hs-source-dirs: src
  default-extensions:
    DeriveAnyClass
    TypeFamilies

  build-depends:
    aeson >=2.2 && <2.3,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    json-fleece-aeson >=0.5.2 && <0.6,
    json-fleece-core >=0.13 && <0.14,
    json-schema-hs >=0.1 && <0.2,
    non-empty-text >=0.2 && <0.3,
    ordered-containers >=0.2 && <0.3,
    scientific >=0.3 && <0.4,
    shrubbery >=0.3 && <0.4,
    text >=2.1 && <2.2,
    vector >=0.13 && <0.14,
