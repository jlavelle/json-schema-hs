cabal-version: 3.0
name: json-schema-hs
version: 0.1.0.0
synopsis: JSON Schema Draft 2020-12 validation
description:
  A JSON Schema Draft 2020-12 validator. 'compile' turns a schema and a
  'Registry' of referenced resources into a 'Validator', and 'validate'
  runs it against a JSON value, returning a flat list of structured
  errors with instance and schema locations. The 2020-12 metaschemas are
  built in. 'checkSchema' reports unresolvable references and invalid
  patterns before compiling.

category: Data, Web, JSON
license: MIT
license-file: LICENSE
author: Nebula Lavelle
maintainer: nebula@franticdream.xyz
copyright: 2026 Nebula Lavelle
build-type: Simple
tested-with: ghc ==9.10.3
extra-source-files:
  data/metaschema/draft2020-12/**/*.json

flag ci
  description: More strict ghc options used for development and ci, not intended for end-use.
  manual: True
  default: False

common foundation
  build-depends: base >=4.20 && <5

  if flag(ci)
    build-depends: henforcer
    ghc-options:
      -j
      -fwrite-ide-info
      -hiedir=.hie
      -Weverything
      -Werror
      -Wno-missing-import-lists
      -Wno-missing-local-signatures
      -Wno-monomorphism-restriction
      -Wno-missing-kind-signatures
      -Wprepositive-qualified-module
      -Wno-safe
      -Wno-unsafe
      -Wno-missing-safe-haskell-mode
      -Wno-missing-deriving-strategies
      -Wno-all-missed-specialisations
      -Wno-missed-specialisations
      -Wno-implicit-prelude
      -Wno-missing-role-annotations
      -Wno-unused-packages
      -fplugin
      Henforcer
      -fplugin-opt
      Henforcer:-c../henforcer.toml
  default-extensions:
    OverloadedStrings

  default-language: GHC2024

common bench-dependencies
  other-modules: Bench.Common
  hs-source-dirs: bench
  build-depends:
    aeson >=2.2 && <2.3,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    deepseq >=1.5 && <1.6,
    json-schema-hs,
    ordered-containers >=0.2 && <0.3,
    tasty-bench >=0.4 && <0.6,
    text >=2.1 && <2.2,
    vector >=0.13 && <0.14,

library
  import: foundation
  exposed-modules: JsonSchema.Validate
  reexported-modules: JsonSchema
  hs-source-dirs: src
  build-depends: json-schema-hs:core

library core
  import: foundation
  visibility: public
  exposed-modules:
    JsonSchema
    JsonSchema.Validate.Array
    JsonSchema.Validate.Atomic
    JsonSchema.Validate.Check
    JsonSchema.Validate.Compile
    JsonSchema.Validate.Composition
    JsonSchema.Validate.Conditional
    JsonSchema.Validate.Dialect
    JsonSchema.Validate.Error
    JsonSchema.Validate.Evaluation
    JsonSchema.Validate.Format
    JsonSchema.Validate.Metaschema
    JsonSchema.Validate.Node
    JsonSchema.Validate.Numeric
    JsonSchema.Validate.Object
    JsonSchema.Validate.Path
    JsonSchema.Validate.Registry
    JsonSchema.Validate.Resolve.Prepass
    JsonSchema.Validate.String
    JsonSchema.Validate.Uri

  hs-source-dirs: core
  default-extensions:
    DeriveAnyClass
    TypeFamilies

  ghc-prof-options: -fprof-late
  build-depends:
    aeson >=2.2 && <2.3,
    attoparsec >=0.14 && <0.15,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    deepseq >=1.5 && <1.6,
    file-embed >=0.0.16 && <0.1,
    hashable >=1.5 && <1.6,
    ip >=1.7 && <1.8,
    ordered-containers >=0.2 && <0.3,
    regex-tdfa >=1.3 && <1.4,
    scientific >=0.3 && <0.4,
    text >=2.1 && <2.2,
    time >=1.12 && <1.13,
    unordered-containers >=0.2 && <0.3,
    uuid-types >=1.0 && <1.1,
    vector >=0.13 && <0.14,

executable json-schema-hs-profile
  import: foundation, bench-dependencies
  main-is: Profile.hs
  ghc-options:
    -rtsopts
    -threaded
    -fprof-late

benchmark json-schema-hs-bench
  import: foundation, bench-dependencies
  type: exitcode-stdio-1.0
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts
    "-N -T -A32m"
