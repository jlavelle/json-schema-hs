cabal-version: 3.0
name: json-schema-hs-test
version: 0.1.0.0
synopsis: Test suites for json-schema-hs and json-schema-hs-fleece
category: Testing
license: MIT
license-file: LICENSE
author: Nebula Lavelle
maintainer: nebula@franticdream.xyz
copyright: 2026 Nebula Lavelle
build-type: Simple
tested-with: ghc ==9.10.3
extra-source-files: fleece-test/golden/*.json

flag ci
  description: More strict ghc options used for development and ci, not intended for end-use.
  manual: True
  default: False

common foundation
  build-depends: base >=4.20 && <5

  if flag(ci)
    build-depends: henforcer
    ghc-options:
      -j
      -fwrite-ide-info
      -hiedir=.hie
      -Weverything
      -Werror
      -Wno-missing-import-lists
      -Wno-missing-local-signatures
      -Wno-monomorphism-restriction
      -Wno-missing-kind-signatures
      -Wprepositive-qualified-module
      -Wno-safe
      -Wno-unsafe
      -Wno-missing-safe-haskell-mode
      -Wno-missing-deriving-strategies
      -Wno-all-missed-specialisations
      -Wno-missed-specialisations
      -Wno-implicit-prelude
      -Wno-missing-role-annotations
      -Wno-unused-packages
      -fplugin
      Henforcer
      -fplugin-opt
      Henforcer:-c../henforcer.toml
  default-extensions:
    OverloadedStrings

  default-language: GHC2024

library test-util
  import: foundation
  exposed-modules:
    SchemaGen
    TestUtil

  hs-source-dirs: test-util
  build-depends:
    aeson >=2.2 && <2.3,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    deepseq >=1.5 && <1.6,
    directory >=1.3 && <1.4,
    filepath >=1.5 && <1.6,
    hedgehog >=1.5 && <1.8,
    json-schema-hs,
    ordered-containers >=0.2 && <0.3,
    scientific >=0.3 && <0.4,
    tasty-hunit >=0.10 && <0.11,
    text >=2.1 && <2.2,
    vector >=0.13 && <0.14,

test-suite json-schema-hs-test
  import: foundation
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    ReferenceTests
    Test

  hs-source-dirs: test
  build-depends:
    aeson >=2.2 && <2.3,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    directory >=1.3 && <1.4,
    filepath >=1.5 && <1.6,
    hedgehog >=1.5 && <1.8,
    json-schema-hs,
    json-schema-hs-test:test-util,
    json-schema-hs:core,
    ordered-containers >=0.2 && <0.3,
    scientific >=0.3 && <0.4,
    tasty >=1.5 && <1.6,
    tasty-hedgehog >=1.4 && <1.5,
    tasty-hunit >=0.10 && <0.11,
    text >=2.1 && <2.2,
    unordered-containers >=0.2 && <0.3,
    vector >=0.13 && <0.14,

  ghc-options:
    -rtsopts
    -threaded
    -with-rtsopts
    "-T -N"

test-suite json-schema-hs-fleece-test
  import: foundation
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    CodecTests
    GenerateTests
    JsonSchemaGoldenTest

  hs-source-dirs: fleece-test
  build-depends:
    aeson >=2.2 && <2.3,
    aeson-pretty >=0.8 && <0.9,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    directory >=1.3 && <1.4,
    filepath >=1.5 && <1.6,
    hedgehog >=1.5 && <1.8,
    json-fleece-aeson >=0.5.2 && <0.6,
    json-fleece-core >=0.13 && <0.14,
    json-schema-hs,
    json-schema-hs-fleece,
    json-schema-hs-test:test-util,
    ordered-containers >=0.2 && <0.3,
    scientific >=0.3 && <0.4,
    tasty >=1.5 && <1.6,
    tasty-golden >=2.3 && <2.4,
    tasty-hedgehog >=1.4 && <1.5,
    tasty-hunit >=0.10 && <0.11,
    text >=2.1 && <2.2,
    vector >=0.13 && <0.14,

  ghc-options:
    -rtsopts
    -threaded
    -with-rtsopts
    "-T -N"
